# ==============================================================================
# AgentCart Platform Environment Configuration (Example)
# ==============================================================================

# Agent LLM Keys (Groq API Keys)
BUYER_AGENT=gsk_placeholder_buyer_key
SELLER_AGENT=gsk_placeholder_seller_key

# Razorpay Test Mode Credentials (Shared Platform Rails)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Role-Based Authentication & Session Secret
JWT_SECRET=agentcart_super_secret_jwt_key_2026

# Cloudinary CDN Configuration (Optional for merchant product media)
CLOUDINARY_NAME=placeholder_cloud_name
API_KEY=placeholder_cloudinary_api_key
API_SECRET=placeholder_cloudinary_api_secret

# System Mode & Ports
MOCK_MODE=false
PORT=4000
FRONTEND_PORT=5173
REDIS_URL=redis://localhost:6379

# Resilience & Rate Limiting
BOT_RATE_LIMIT_PER_MINUTE=30
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_MS=30000
EXTERNAL_CALL_TIMEOUT_MS=10000
