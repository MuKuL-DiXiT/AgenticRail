# .env.example

GROQ_API_KEY_ORCHESTRATOR=replace_me

GROQ_API_KEY_WORKER_1=replace_me   # fast/cheap bidder
GROQ_API_KEY_WORKER_2=replace_me   # load-based bidder
GROQ_API_KEY_WORKER_3=replace_me   # specialist/keyword-filtered bidder
GROQ_API_KEY_WORKER_4=replace_me   # premium/high-quality bidder
GROQ_API_KEY_WORKER_5=replace_me   # spare / judge-bot (quality check before release)

# All Groq calls mocked while true — keep true until real keys are pasted in.
MOCK_MODE=true

REDIS_URL=redis://localhost:6379
PORT=4000
FRONTEND_PORT=5173
ORCHESTRATOR_STARTING_BUDGET=1000

# Resilience / rate limiting tuning
BOT_RATE_LIMIT_PER_MINUTE=30
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_MS=30000
EXTERNAL_CALL_TIMEOUT_MS=10000
