# ==============================================================================
# BotBot Autonomous Marketplace Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# API Keys (Replace these placeholders!)
# ------------------------------------------------------------------------------
# Replace these with your actual test-mode keys. DO NOT use live keys.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_replace_me
RAZORPAY_WEBHOOK_SECRET=placeholder_replace_me

# Replace these if you are not using MOCK_MODE=true
GROQ_API_KEY_ORCHESTRATOR=replace_me
GROQ_API_KEY_WORKER_1=replace_me
GROQ_API_KEY_WORKER_2=replace_me
GROQ_API_KEY_WORKER_3=replace_me
GROQ_API_KEY_WORKER_4=replace_me
GROQ_API_KEY_WORKER_5=replace_me

# ------------------------------------------------------------------------------
# System Toggles
# ------------------------------------------------------------------------------
# MOCK_MODE=true completely bypasses the real Groq API to save costs during dev.
MOCK_MODE=true
# DEMO_MODE=true automates the Orchestrator broadcasting tasks repeatedly.
DEMO_MODE=false

# ------------------------------------------------------------------------------
# Infrastructure
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
PORT=4000
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# Agent Economics & Resilience 
# ------------------------------------------------------------------------------
ORCHESTRATOR_STARTING_BUDGET=1000
BOT_RATE_LIMIT_PER_MINUTE=30
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_MS=30000
EXTERNAL_CALL_TIMEOUT_MS=10000
